{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "yorimichi_v2/asset.schema.json",
  "title": "asset.toml: one V2 asset or small asset family",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "authority",
    "owner",
    "outputs"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$",
      "description": "stable ID, e.g. prop/harbour-bench-01"
    },
    "kind": {
      "enum": [
        "static-mesh",
        "skeletal-mesh",
        "skeleton",
        "animation",
        "material",
        "material-instance",
        "texture",
        "audio",
        "map",
        "blueprint",
        "data",
        "level-instance",
        "foliage",
        "physics",
        "adopted"
      ]
    },
    "authority": {
      "enum": [
        "generated",
        "editor",
        "split"
      ],
      "description": "generated: sources+recipe own the packages; editor: the saved packages are the source; split: each output names its writer"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$",
      "description": "claim scope needed to edit it, e.g. region/w04-skatepark or shared/material/painted"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "relative to the asset folder"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "required": [
        "importer",
        "version"
      ],
      "properties": {
        "importer": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "settings": {
          "type": "object"
        }
      },
      "description": "required for generated/split, absent for editor-owned"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
      },
      "description": "assets read by reference; their changes never reimport this one"
    },
    "input_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
      },
      "description": "assets whose verified state is part of this one's input fingerprint (e.g. a skeleton for an animation)"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package"
        ],
        "properties": {
          "package": {
            "type": "string",
            "pattern": "^/Game(/[A-Za-z0-9_.-]+)+$"
          },
          "writer": {
            "enum": [
              "generated",
              "editor"
            ]
          }
        }
      }
    },
    "license": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "named checks this asset must pass, e.g. collision.walkable"
    }
  }
}
