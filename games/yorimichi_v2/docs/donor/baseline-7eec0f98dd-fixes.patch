+++ b/games/yorimichi/unreal/Scripts/donor_tris.py
@@ -0,0 +1,19 @@
+"""Donor-only: UE 5.8 may build a few fewer triangles than the source records. Log every difference; refuse gains
+and losses over 1%. Reviewed before adoption (grep 'V2 DONOR TRIANGLES' in the build logs)."""
+import unreal
+
+
+def ok(built, expected, name):
+    if built != expected:
+        unreal.log_warning(f'V2 DONOR TRIANGLES {name} built={built} expected={expected}')
+    return expected * 0.97 <= built <= expected
+
+
+def mesh_subsystem():
+    """StaticMeshEditorSubsystem, loading its engine module first when a reduced editor has not."""
+    found = unreal.get_editor_subsystem(unreal.StaticMeshEditorSubsystem)
+    if found is None:
+        unreal.load_module('StaticMeshEditor')
+        found = unreal.get_editor_subsystem(unreal.StaticMeshEditorSubsystem)
+    assert found is not None, 'StaticMeshEditorSubsystem unavailable'
+    return found
