# .glb, .bin, .ktx2, .ogg and .wav files are stored in Git LFS: a checkout needs git-lfs installed to get the real files.
*.glb filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.skatepack filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
# Preserve pinned upstream whitespace and identify the local dependency copy for review.
vendor/bevy_pbr/** -whitespace linguist-vendored
