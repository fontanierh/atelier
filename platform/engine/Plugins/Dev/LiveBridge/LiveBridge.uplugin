{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "0.1 (experimental)",
  "FriendlyName": "Live Bridge",
  "Description": "Loopback HTTP bridge for agents and tools: run Python in the running game, read its state, place GLB props at runtime and keep them in overlay files.",
  "Category": "Atelier|Dev",
  "CreatedBy": "Atelier",
  "CanContainContent": false,
  "Modules": [
    {
      "Name": "AtelierLive",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "AtelierCore",
      "Enabled": true
    },
    {
      "Name": "PythonScriptPlugin",
      "Enabled": true
    },
    {
      "Name": "Interchange",
      "Enabled": true
    }
  ]
}
