# Copy to .env and fill in. .env is ignored by git; never commit or print these values.
# Only paid AI calls need them (the AI clients and make_prop.py); building and playing a game does not.
OPENAI_API_KEY=
# Vercel AI Gateway: H3 Max and Seedance reference videos
AI_GATEWAY_API_KEY=
TRIPO_API_KEY=

# Suno web session refresh credentials (the __client cookie and __client_uat).
# The client rotates the refresh token; re-copy both values from a signed-in browser if it stops working.
SUNO_CLIENT_COOKIE=
SUNO_CLIENT_UAT=
