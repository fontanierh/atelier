#!/bin/sh
# Upload the Git LFS objects of the pushed commits before the commits themselves (games/hakuba and games/yorimichi_v2
# keep their binaries in LFS). Without git-lfs those binaries cannot be committed or pushed correctly (no pointers,
# no uploads), so the push fails rather than silently skipping the upload.
if command -v git-lfs >/dev/null 2>&1; then
  exec git lfs pre-push "$@"
fi
echo "pre-push: git-lfs is not installed; install it (brew install git-lfs) before pushing" >&2
exit 1
