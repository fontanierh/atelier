{
  "name": "Contract review events",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/contract-review.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target", "issue_comment"]
      }
    }
  ]
}
